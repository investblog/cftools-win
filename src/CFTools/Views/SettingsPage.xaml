<Page
  x:Class="CFTools.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CFTools.Views.Controls"
>
  <ScrollViewer>
    <StackPanel Padding="16" Spacing="24" MaxWidth="480" HorizontalAlignment="Left">
      <!-- Force StackPanel to match Auth/About width -->
      <TextBlock
        x:Uid="Settings_Title"
        Text="Settings"
        Style="{StaticResource TitleTextBlockStyle}"
        MinWidth="448"
      />

      <!-- Request Pool -->
      <StackPanel Spacing="16">
        <TextBlock
          x:Uid="Settings_Pool"
          Text="Request Pool"
          Style="{StaticResource SubtitleTextBlockStyle}"
        />

        <Slider
          x:Uid="Settings_Concurrency"
          Header="Max Concurrency"
          Minimum="1"
          Maximum="8"
          SnapsTo="StepValues"
          StepFrequency="1"
          TickFrequency="1"
          TickPlacement="Outside"
          HorizontalAlignment="Stretch"
          Value="{x:Bind ViewModel.MaxConcurrency, Mode=TwoWay}"
        />

        <Slider
          x:Uid="Settings_Retries"
          Header="Max Retries"
          Minimum="0"
          Maximum="5"
          SnapsTo="StepValues"
          StepFrequency="1"
          TickFrequency="1"
          TickPlacement="Outside"
          HorizontalAlignment="Stretch"
          Value="{x:Bind ViewModel.MaxRetries, Mode=TwoWay}"
        />
      </StackPanel>

      <!-- Appearance -->
      <StackPanel Spacing="12">
        <TextBlock
          x:Uid="Settings_Appearance"
          Text="Appearance"
          Style="{StaticResource SubtitleTextBlockStyle}"
        />

        <ComboBox
          x:Uid="Settings_Theme"
          Header="Theme"
          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
          Width="200"
        >
          <ComboBoxItem x:Uid="Settings_ThemeSystem" Content="System" />
          <ComboBoxItem x:Uid="Settings_ThemeLight" Content="Light" />
          <ComboBoxItem x:Uid="Settings_ThemeDark" Content="Dark" />
        </ComboBox>

        <ComboBox
          x:Uid="Settings_Language"
          Header="Language"
          ItemsSource="{x:Bind ViewModel.LanguageNames}"
          SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
          Width="240"
        />
        <TextBlock
          x:Uid="Settings_RestartNote"
          Text="Restart the app to apply the new language."
          FontSize="12"
          TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCautionBrush}"
          Visibility="{x:Bind ViewModel.ShowRestartNote, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />
      </StackPanel>

      <!-- 301.st -->
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:Logo301 Width="20" Height="20" VerticalAlignment="Center" />
          <TextBlock Text="301.st" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>

        <ToggleSwitch
          x:Uid="Settings_Tips"
          Header="Show 301.st tips"
          OnContent="On"
          OffContent="Off"
          IsOn="{x:Bind ViewModel.Show301Tips, Mode=TwoWay}"
        />
        <TextBlock
          x:Uid="Settings_TipsHint"
          Text="Short, contextual hints about 301.st, the publisher's domain management service: after zones are created and while zones are still pending. Nothing is sent anywhere."
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
