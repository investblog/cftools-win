<Page
  x:Class="CFTools.Views.ZonesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CFTools.Views.Controls"
  xmlns:vm="using:CFTools.ViewModels"
  NavigationCacheMode="Required"
>
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutStates">
        <VisualState x:Name="NarrowLayout" />
        <VisualState x:Name="WideLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="NarrowToolbar.Visibility" Value="Collapsed" />
            <Setter Target="WideToolbar.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ProgressBar
      Grid.Row="0"
      IsIndeterminate="True"
      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
    />

    <Grid Grid.Row="1" Padding="16" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Zones" Style="{StaticResource TitleTextBlockStyle}" />

      <StackPanel Grid.Row="1">
        <TextBlock
          Text="{x:Bind ViewModel.AccountContextText, Mode=OneWay}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="WrapWholeWords"
          Visibility="{x:Bind ViewModel.IsAccountMissing, Mode=OneWay, Converter={StaticResource InvertBoolToVisConverter}}"
        />
        <HyperlinkButton
          Content="Connect and select an account to get started"
          Padding="0"
          Click="GoToAuth_Click"
          Visibility="{x:Bind ViewModel.IsAccountMissing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="WrapWholeWords"
        />
        <StackPanel
          Orientation="Horizontal"
          Spacing="6"
          Visibility="{x:Bind ViewModel.ShowPendingHint, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        >
          <controls:Logo301 Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock
            FontSize="12"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          >
            <Run Text="{x:Bind ViewModel.PendingZonesHint, Mode=OneWay}" />
            <Hyperlink NavigateUri="{x:Bind ViewModel.ZonesPendingUrl}"
              >Check nameservers in bulk in 301.st</Hyperlink
            >
          </TextBlock>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="3">
        <Grid x:Name="NarrowToolbar" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBox
            Grid.Row="0"
            PlaceholderText="Filter zones..."
            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{x:Bind ViewModel.CanLoadZones, Mode=OneWay}"
          />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
              Content="Refresh"
              Style="{StaticResource AccentButtonStyle}"
              Command="{x:Bind ViewModel.LoadZonesCommand}"
              IsEnabled="{x:Bind ViewModel.CanLoadZones, Mode=OneWay}"
            />
            <Button
              Content="Export CSV"
              Command="{x:Bind ViewModel.ExportCsvCommand}"
              IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
            />
            <Button
              Content="All accounts"
              ToolTipService.ToolTip="Export zones from every account into one CSV"
              Command="{x:Bind ViewModel.ExportAllAccountsCsvCommand}"
              IsEnabled="{x:Bind ViewModel.CanExportAllAccounts, Mode=OneWay}"
            />
          </StackPanel>
        </Grid>

        <StackPanel
          x:Name="WideToolbar"
          Orientation="Horizontal"
          Spacing="8"
          Visibility="Collapsed"
        >
          <Button
            Content="Refresh"
            Style="{StaticResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.LoadZonesCommand}"
            IsEnabled="{x:Bind ViewModel.CanLoadZones, Mode=OneWay}"
          />
          <TextBox
            Width="220"
            PlaceholderText="Filter zones..."
            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{x:Bind ViewModel.CanLoadZones, Mode=OneWay}"
          />
          <Button
            Content="Export CSV"
            Command="{x:Bind ViewModel.ExportCsvCommand}"
            IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
          />
          <Button
            Content="Export all accounts"
            ToolTipService.ToolTip="Export zones from every account into one CSV"
            Command="{x:Bind ViewModel.ExportAllAccountsCsvCommand}"
            IsEnabled="{x:Bind ViewModel.CanExportAllAccounts, Mode=OneWay}"
          />
        </StackPanel>
      </Grid>

      <ListView
        Grid.Row="4"
        ItemsSource="{x:Bind ViewModel.VisibleZones, Mode=OneWay}"
        SelectionMode="None"
        Padding="0"
        MaxWidth="760"
        HorizontalAlignment="Left"
      >
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:ZoneRow">
            <Grid ColumnSpacing="8" Padding="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="1">
                <TextBlock
                  Text="{x:Bind ZoneName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTipService.ToolTip="{x:Bind ZoneName, Converter={StaticResource PunycodeTooltipConverter}}"
                />
                <TextBlock
                  Text="{x:Bind NameServersText}"
                  FontSize="11"
                  TextTrimming="CharacterEllipsis"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                />
              </StackPanel>
              <TextBlock
                Grid.Column="1"
                Text="{x:Bind PlanName}"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
              <Border
                Grid.Column="2"
                Background="{x:Bind ZoneStatus, Mode=OneWay, Converter={StaticResource StatusToBgConverter}}"
                CornerRadius="4"
                Padding="8,2"
                VerticalAlignment="Center"
              >
                <TextBlock
                  Text="{x:Bind ZoneStatus, Mode=OneWay}"
                  Foreground="{x:Bind ZoneStatus, Mode=OneWay, Converter={StaticResource StatusToFgConverter}}"
                  FontSize="11"
                  FontWeight="SemiBold"
                />
              </Border>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
