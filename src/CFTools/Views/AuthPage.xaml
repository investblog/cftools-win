<Page
  x:Class="CFTools.Views.AuthPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:CFTools.Views.Controls"
  xmlns:vm="using:CFTools.ViewModels"
  NavigationCacheMode="Required"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ProgressBar
      Grid.Row="0"
      IsIndeterminate="True"
      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
    />

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="16" Spacing="16" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Cloudflare Authentication" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock
          Text="Connect with an API token (cfut_ / cfat_) or your Global API Key. The kind is detected from the pasted secret."
          TextWrapping="Wrap"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />

        <PasswordBox
          x:Name="ApiKeyBox"
          Header="API token or Global API Key"
          PlaceholderText="cfut_… / cfat_… / Global API Key"
          IsEnabled="{x:Bind ViewModel.CanEditCredentials, Mode=OneWay}"
          PasswordChanged="ApiKeyBox_PasswordChanged"
        />

        <TextBlock
          Text="{x:Bind ViewModel.CredentialHint, Mode=OneWay}"
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Visibility="{x:Bind ViewModel.CredentialHint, Mode=OneWay, Converter={StaticResource StringToVisConverter}}"
        />

        <TextBox
          Header="Email (Global API Key only)"
          PlaceholderText="you@example.com"
          Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{x:Bind ViewModel.CanEditCredentials, Mode=OneWay}"
          Visibility="{x:Bind ViewModel.IsEmailRequired, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />

        <TextBox
          Header="Account ID (optional, for account-owned tokens)"
          PlaceholderText="32-character account ID from the Cloudflare dashboard"
          Text="{x:Bind ViewModel.AccountIdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{x:Bind ViewModel.CanEditCredentials, Mode=OneWay}"
          Visibility="{x:Bind ViewModel.ShowAccountIdField, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />

        <InfoBar
          x:Name="StatusBar"
          IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
          Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
          Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
          IsClosable="False"
        />

        <ComboBox
          Header="Account"
          ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
          DisplayMemberPath="Name"
          PlaceholderText="Select an account..."
          HorizontalAlignment="Stretch"
          BorderBrush="{StaticResource SystemControlHighlightAccentBrush}"
          BorderThickness="2"
          Visibility="{x:Bind ViewModel.ShowAccountPicker, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />

        <TextBlock
          Text="Select an account to finish sign-in, or disconnect to return to the sign-in form."
          TextWrapping="Wrap"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Visibility="{x:Bind ViewModel.ShowAccountPicker, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button
            Content="Connect"
            Style="{StaticResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.ConnectCommand}"
            Visibility="{x:Bind ViewModel.ShowConnectAction, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
          />
          <Button
            Content="Switch account"
            Command="{x:Bind ViewModel.SwitchAccountCommand}"
            Visibility="{x:Bind ViewModel.ShowSwitchAccountAction, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
          />
          <Button
            Content="Disconnect"
            Command="{x:Bind ViewModel.DisconnectCommand}"
            Visibility="{x:Bind ViewModel.ShowDisconnectAction, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
          />
          <Button
            Content="Forget credentials"
            Command="{x:Bind ViewModel.ForgetCommand}"
            Visibility="{x:Bind ViewModel.ShowForgetAction, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
          >
            <Button.Resources>
              <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
              <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#A12316" />
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#861D12" />
              <SolidColorBrush x:Key="ButtonForeground" Color="White" />
              <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
              <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CCFFFFFF" />
              <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C42B1C" />
              <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#A12316" />
              <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#861D12" />
            </Button.Resources>
          </Button>
        </StackPanel>

        <StackPanel
          Spacing="8"
          Margin="0,24,0,0"
          Opacity="0.7"
          Visibility="{x:Bind ViewModel.CanEditCredentials, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        >
          <TextBlock Text="Where to get credentials" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="Log in to" />
            <Hyperlink NavigateUri="https://dash.cloudflare.com/profile/api-tokens"
              >dash.cloudflare.com</Hyperlink
            >
            <Run Text=" and open My Profile > API Tokens. Create a token, or view the Global API Key. Account-owned tokens live under Manage Account > API Tokens." />
          </TextBlock>

          <TextBlock Text="API token permissions" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock
            Text="Zone > Zone > Edit (create, list, delete zones), Zone > Cache Purge > Purge, and Account > Account Settings > Read (to list your accounts)."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />

          <TextBlock
            Text="When to prefer the Global API Key"
            FontWeight="SemiBold"
            Margin="0,8,0,0"
          />
          <TextBlock
            Text="Some new accounts cap zone creation for API tokens at the number of zones that already exist, which blocks bulk add from zero. The Global API Key does not hit that limit. Either secret stays in Windows Credential Manager and is sent only to the Cloudflare API."
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </StackPanel>

        <StackPanel
          Orientation="Horizontal"
          Spacing="8"
          Margin="0,8,0,0"
          Visibility="{x:Bind ViewModel.ShowTips, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
        >
          <controls:Logo301 Width="16" Height="16" VerticalAlignment="Center" />
          <TextBlock
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          >
            <Run Text="For redirects, TDS and domain management:" />
            <Hyperlink NavigateUri="{x:Bind ViewModel.PromoUrl}">301.st</Hyperlink>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
