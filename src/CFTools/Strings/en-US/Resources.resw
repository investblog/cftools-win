  <data name="About_Tagline.Text" xml:space="preserve">
    <value>Independent bulk zone management for Cloudflare accounts, on Windows</value>
  </data>
  <data name="About_WhatTitle.Text" xml:space="preserve">
    <value>What it does</value>
  </data>
  <data name="About_F1Title.Text" xml:space="preserve">
    <value>Bulk Add</value>
  </data>
  <data name="About_F1Body.Text" xml:space="preserve">
    <value> - paste domains from any source. Smart parser handles CSV, HTML, emails, URLs, IDN/Punycode.</value>
  </data>
  <data name="About_F2Title.Text" xml:space="preserve">
    <value>Bulk Purge</value>
  </data>
  <data name="About_F2Body.Text" xml:space="preserve">
    <value> - clear cache for multiple zones at once with filtering and progress tracking.</value>
  </data>
  <data name="About_F3Title.Text" xml:space="preserve">
    <value>Bulk Delete</value>
  </data>
  <data name="About_F3Body.Text" xml:space="preserve">
    <value> - remove zones safely with confirmation, auto-reload, and per-zone status.</value>
  </data>
  <data name="About_F4Title.Text" xml:space="preserve">
    <value>Zone List</value>
  </data>
  <data name="About_F4Body.Text" xml:space="preserve">
    <value> - browse every zone with status, plan and name servers; export to CSV for one account or all accounts at once.</value>
  </data>
  <data name="About_F5Title.Text" xml:space="preserve">
    <value>Batch export</value>
  </data>
  <data name="About_F5Body.Text" xml:space="preserve">
    <value> - save the outcome of any add, purge or delete run as CSV with per-domain status and error.</value>
  </data>
  <data name="About_F6Title.Text" xml:space="preserve">
    <value>API tokens or Global API Key</value>
  </data>
  <data name="About_F6Body.Text" xml:space="preserve">
    <value> - user tokens (cfut_), account-owned tokens (cfat_) or the classic key; the kind is detected automatically.</value>
  </data>
  <data name="About_F7Title.Text" xml:space="preserve">
    <value>Multi-account</value>
  </data>
  <data name="About_F7Body.Text" xml:space="preserve">
    <value> - switch between Cloudflare accounts without re-entering credentials.</value>
  </data>
  <data name="About_BuiltTitle.Text" xml:space="preserve">
    <value>Built by 301.st</value>
  </data>
  <data name="About_Built1.Text" xml:space="preserve">
    <value>301.st is an edge redirect management platform built on Cloudflare Workers. It delivers intelligent URL redirects with GEO/UA filtering, real-time analytics, and sub-20ms response times globally.</value>
  </data>
  <data name="About_Built2.Text" xml:space="preserve">
    <value>Cloudflare Tools started as a browser extension to simplify bulk zone operations and is now available as a native Windows app with a cleaner, safer workflow.</value>
  </data>
  <data name="About_LinksTitle.Text" xml:space="preserve">
    <value>Links</value>
  </data>
  <data name="About_Rate.Content" xml:space="preserve">
